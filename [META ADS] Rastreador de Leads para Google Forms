// ===== FUNÇÃO PRINCIPAL - DISPARA NO ENVIO DO FORMULÁRIO =====
function onFormSubmit(e) {
  try {
    Logger.log('═══════════════════════════════════════');
    Logger.log('🚀 INÍCIO DO RASTREAMENTO - VAGAS');
    Logger.log('═══════════════════════════════════════');
    
    // Abrir a planilha e pegar a última linha (resposta mais recente)
    const spreadsheet = SpreadsheetApp.openById(CONFIG.SHEET_ID);
    const sheet = spreadsheet.getSheets()[0];
    const lastRow = sheet.getLastRow();
    
    // Pegar os cabeçalhos (nomes dos campos)
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    // Pegar os valores da última linha
    const values = sheet.getRange(lastRow, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    // Criar objeto com respostas
    const responses = {};
    headers.forEach(function(header, index) {
      if (header && header.toString().trim() !== '') {
        responses[header] = values[index] || '';
        Logger.log(`✓ ${header}: ${values[index]}`);
      }
    });
    
    Logger.log('');
    Logger.log('📊 Processando dados...');
    
    // ===== EXTRAIR E PROCESSAR DADOS =====
    const rawName = responses['Nome Completo'] || '';
    const rawEmail = responses['E-mail'] || '';
    const rawPhone = responses['Número de telefone- Whats'] || '';
    const endereco = responses['Endereço'] || '';
    const bairroCidade = responses['Bairro, Cidade'] || '';
    const interesse = responses['INTERESSE PROFISSIONAL-Para qual área você deseja se candidatar?'] || '';
    const temExperiencia = responses['Possui experiência na área desejada?'] || '';
    const disponibilidadeHorario = responses['Qual a sua disponibilidade de horário?'] || '';
    const trabalharSabado = responses['Tem disponibilidade para trabalhar aos sábados?'] || '';
    const pretensaoSalarial = responses['Qual a sua pretensão salarial?'] || '';
    const inicioImediato = responses['Tem disponibilidade para início imediato?'] || '';
    
    // Processar dados para hash
    const email = rawEmail.toString().trim().toLowerCase();
    const phone = rawPhone.toString().replace(/\D/g, ''); // Remove tudo que não é número
    
    // Separar nome
    const nameParts = rawName.trim().split(' ');
    const firstName = nameParts[0]?.toLowerCase() || '';
    const lastName = nameParts.slice(1).join(' ').toLowerCase() || '';
    
    // Extrair cidade e estado (se possível)
    let city = '';
    let state = '';
    if (bairroCidade) {
      const parts = bairroCidade.split(',');
      if (parts.length >= 2) {
        city = parts[parts.length - 1].trim().toLowerCase();
      }
    }
    
    Logger.log('✓ Dados extraídos e processados');
    
    // ===== HASHEAR DADOS (META CAPI REQUER HASH SHA256) =====
    const userData = {};
    if (email) userData.em = sha256Hash(email);
    if (phone) userData.ph = sha256Hash(phone);
    if (firstName) userData.fn = sha256Hash(firstName);
    if (lastName) userData.ln = sha256Hash(lastName);
    if (city) userData.ct = sha256Hash(city);
    if (state) userData.st = sha256Hash(state);
    userData.country = sha256Hash('br'); // País: Brasil
    
    Logger.log('✓ Dados hasheados com SHA256');
    
    // ===== CUSTOM DATA - Informações extras para segmentação =====
    const customData = {
      interesse_profissional: interesse,
      tem_experiencia: temExperiencia,
      disponibilidade_horario: disponibilidadeHorario,
      trabalha_sabado: trabalharSabado,
      pretensao_salarial: pretensaoSalarial,
      inicio_imediato: inicioImediato,
      content_name: 'Inscricao_Vaga_Emprego',
      content_category: 'Recrutamento'
    };
    
    // ===== MONTAR PAYLOAD PARA META CAPI =====
    const payload = {
      data: [{
        event_name: 'Lead',
        event_time: Math.floor(Date.now() / 1000),
        action_source: 'system_generated',
        event_source_url: `https://docs.google.com/forms/d/e/${CONFIG.FORM_ID}/viewform`,
        user_data: userData,
        custom_data: customData
      }]
    };
    
    Logger.log('');
    Logger.log('📤 Enviando para Meta CAPI...');
    
    // ===== ENVIAR PARA META CONVERSIONS API =====
    const url = `https://graph.facebook.com/v21.0/${CONFIG.PIXEL_ID}/events?access_token=${CONFIG.ACCESS_TOKEN}`;
    
    const options = {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };
    
    const response = UrlFetchApp.fetch(url, options);
    const result = JSON.parse(response.getContentText());
    
    Logger.log('');
    Logger.log('📥 Resposta da API:');
    Logger.log(JSON.stringify(result, null, 2));
    
    // ===== VERIFICAR SUCESSO =====
    if (result.events_received && result.events_received > 0) {
      Logger.log('');
      Logger.log('✅ SUCESSO! Evento Lead enviado para Meta');
      Logger.log(`   Eventos recebidos: ${result.events_received}`);
      if (result.messages) {
        Logger.log(`   Mensagens: ${JSON.stringify(result.messages)}`);
      }
    } else {
      Logger.log('');
      Logger.log('⚠️ ATENÇÃO: Possível erro no envio');
      Logger.log('   Resposta completa: ' + JSON.stringify(result));
    }
    
    Logger.log('');
    Logger.log('═══════════════════════════════════════');
    Logger.log('🏁 FIM DO RASTREAMENTO');
    Logger.log('═══════════════════════════════════════');
    
  } catch (error) {
    Logger.log('');
    Logger.log('❌ ERRO CRÍTICO:');
    Logger.log(error.toString());
    Logger.log('Stack: ' + error.stack);
  }
}

// ===== FUNÇÃO SHA256 =====
function sha256Hash(input) {
  if (!input) return '';
  
  const rawHash = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    input.toString().toLowerCase().trim()
  );
  
  let hash = '';
  for (let i = 0; i < rawHash.length; i++) {
    let byte = rawHash[i];
    if (byte < 0) byte += 256;
    let byteStr = byte.toString(16);
    if (byteStr.length === 1) byteStr = '0' + byteStr;
    hash += byteStr;
  }
  
  return hash;
}

