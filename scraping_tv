from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.common.by import By
from webdriver_manager.chrome import ChromeDriverManager
from openpyxl import Workbook
import time

def iniciar_driver():
    options = webdriver.ChromeOptions()
    options.add_argument('--headless')  # Comente se quiser ver o navegador
    options.add_argument('--no-sandbox')
    options.add_argument('--disable-dev-shm-usage')
    return webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)

def acessar_pagina_programacao(driver, url):
    driver.get(url)
    time.sleep(5)  # Esperar carregamento JS

def expandir_todos_os_dias(driver):
    expand_buttons = driver.find_elements(By.CSS_SELECTOR, '.accordion .accordionTitle button')
    for button in expand_buttons:
        try:
            driver.execute_script("arguments[0].scrollIntoView(true);", button)
            driver.execute_script("arguments[0].click();", button)
            time.sleep(0.3)
        except Exception:
            continue
    time.sleep(2)

def coletar_programacao(driver):
    dias = driver.find_elements(By.CSS_SELECTOR, '.accordion')
    programacao_total = []

    for dia in dias:
        try:
            data_dia = dia.get_attribute("id")  # Ex: 20250730
            if not data_dia or len(data_dia) != 9 and len(data_dia) != 8:
                continue

            # Formatar data
            ano = data_dia[:4]
            mes = data_dia[4:6]
            dia_num = data_dia[6:]
            data_formatada = f"{dia_num}/{mes}/{ano}"

            blocos_programas = dia.find_elements(By.CSS_SELECTOR, '.accordionTitle')

            for bloco in blocos_programas:
                try:
                    horario = bloco.find_element(By.CSS_SELECTOR, '.accordionTitle__time time p').text.strip()
                    programa = bloco.find_element(By.CSS_SELECTOR, '.accordionTitle__name p').text.strip()
                    programacao_total.append([data_formatada, horario, programa])
                except:
                    continue
        except:
            continue

    return programacao_total

def salvar_em_excel(programacao, nome_arquivo):
    wb = Workbook()
    ws = wb.active
    ws.title = "Programação TV Asa Branca"
    ws.append(["Data", "Horário", "Programa"])
    for item in programacao:
        ws.append(item)
    wb.save(nome_arquivo)
    print(f"Arquivo salvo com sucesso: {nome_arquivo}")

# ----------------------------
# FLUXO PRINCIPAL
# ----------------------------
if __name__ == "__main__":
    url = 'https://redeglobo.globo.com/pe/tvasabranca/programacao/'
    driver = iniciar_driver()

    try:
        acessar_pagina_programacao(driver, url)
        expandir_todos_os_dias(driver)
        programacao = coletar_programacao(driver)
        salvar_em_excel(programacao, "programacao_completa_tv_asa_branca.xlsx")
    finally:
        driver.quit()
